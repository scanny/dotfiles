#
# .config/git/config: git-config(1) - Git configuration
#
# vim: ft=gitconfig
#

[advice]
    skippedCherryPicks = false

[alias]
    dump = cat-file -p
    type = cat-file -t

[color]
    diff = auto
    ui   = true

[core]
    autocrlf = input
    safecrlf = true
    editor = nvim
    ; pager = less
    ; -- `-c` option causes content to always appear at the top of the screen, even when
    ; -- less than a screenful
    pager = sed 's/\t/    /g' | less -c
    ; pager = delta --paging=always --pager='less -c'
	excludesfile = /Users/scanny/.config/git/ignore

[credential]
    helper = osxkeychain

; [delta]
;     features = gruvmax-fang
;     navigate = true
;     ; delta detects terminal colors automatically; set one of these to disable auto-detection
;     ; dark = true
;     ; light = true

[diff]
    mnemonicprefix = true
    tool = vimdiff
    algorithm = patience

[difftool]
    prompt = false

[filter "media"]
    required = true
    clean  = git-media-clean %f
    smudge = git-media-smudge %f

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[include]
    path = config-local
    ; path = "/Users/scanny/.config/delta/themes.gitconfig"

[init]
    defaultBranch = main

; [merge]
;     conflictstyle = zdiff3

[pager]
    stash = false

[push]
    default = upstream

[rebase]
    updateRefs = true

[rerere]
    enabled = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all

[url "git@github.com:"]
    insteadOf = https://github.com/

[user]
	name = Steve Canny
	email = stcanny@gmail.com
